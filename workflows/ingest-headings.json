    {
      "id": "c3000000-0000-4000-8000-000000000004",
      "name": "Chunk by headings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Heading-aware chunking: split the handbook text at section and product headings,\n// and start every chunk with a breadcrumb such as\n// \"Section 3. Product Catalogue > Tug Titan Rope (WW-D-101)\".\nconst MAX_CHARS = 1000;\nconst SECTION = /^(\\d{1,2})\\. ([A-Z].+)$/;\nconst PRODUCT = /^(.+) \\((WW-[DCS]-\\d{3})\\)$/;\nconst GROUP_HEADINGS = new Set(['Dog toys', 'Cat toys', 'Small-pet toys']);\n\nconst lines = $input.first().json.text.split('\\n').map((l) => l.trim()).filter(Boolean);\n\nconst blocks = [];\nlet current = { section: 'Introduction', product: '', lines: [] };\nconst flush = () => { if (current.lines.length) blocks.push(current); };\n\nfor (const line of lines) {\n  const s = line.match(SECTION);\n  if (s && Number(s[1]) <= 11) {\n    flush();\n    current = { section: `Section ${s[1]}. ${s[2]}`, product: '', lines: [] };\n    continue;\n  }\n  if (GROUP_HEADINGS.has(line)) continue;\n  const p = line.match(PRODUCT);\n  if (p) {\n    flush();\n    current = { section: current.section, product: `${p[1]} (${p[2]})`, lines: [] };\n    continue;\n  }\n  current.lines.push(line);\n}\nflush();\n\nconst out = [];\nfor (const block of blocks) {\n  const crumb = block.product ? `${block.section} > ${block.product}` : block.section;\n  let buffer = [];\n  let length = 0;\n  const emit = () => {\n    if (!buffer.length) return;\n    out.push({ json: { text: `${crumb}\\n${buffer.join('\\n')}`, section: block.section, product: block.product } });\n    buffer = [];\n    length = 0;\n  };\n  for (const line of block.lines) {\n    if (length + line.length > MAX_CHARS && buffer.length) emit();\n    buffer.push(line);\n    length += line.length + 1;\n  }\n  emit();\n}\nreturn out;"
      }
    },
